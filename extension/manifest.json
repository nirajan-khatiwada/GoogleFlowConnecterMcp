{
  "manifest_version": 3,
  "name": "Flow Connector (Unlimited)",
  "short_name": "Flow Connect",
  "version": "1.3.4",
  "description": "Google Flow Browser Connector — Bulk AI image and video generation. 100% unlocked and unlimited.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "downloads",
    "tabs",
    "scripting",
    "alarms",
    "debugger"
  ],
  "host_permissions": [
    "https://flow.google.com/*",
    "https://labs.google/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/index.ts-loader-fjYmorgJ.js"
      ],
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/*"
      ],
      "run_at": "document_idle"
    },
    {
      "js": [
        "assets/result-capture-flow.ts-loader-Bi4yRDbe.js"
      ],
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/*"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "action": {
    "default_title": "Flow Connector",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "web_accessible_resources": [
    {
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/*"
      ],
      "resources": [
        "assets/remote-selectors-DauVyE_a.js",
        "assets/flow-url-CvYu-sZP.js",
        "assets/links-Bc5QuK_F.js",
        "assets/index.ts--a0w5aTj.js",
        "assets/result-capture-flow.ts-Cu6ONkqg.js"
      ],
      "use_dynamic_url": false
    }
  ]
}